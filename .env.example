# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to the client

# ── AI provider abstraction (see src/lib/ai) ───────────────────────────────
# AI_PROVIDER selects which implementation src/lib/ai/provider.ts loads.
# Swapping providers/models never requires touching application code.
AI_PROVIDER=anthropic               # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-sonnet-5            # the stronger model: match analysis (and later rewrite + QA)

# Optional: use a cheaper/faster model for high-volume extraction steps
AI_MODEL_FAST=claude-haiku-4-5-20251001   # cheaper model for CV/job-description extraction; falls back to AI_MODEL if blank

# ── Paystack ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=                # server-only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
CV_OPTIMIZATION_PRICE_KOBO=500000   # ₦5,000 in kobo

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
